      "kind": "RawDeclaration",
      "value": {
        "type": "RawDeclaration",
        "category": "Module",
        "source": "module Network {\n    pub struct Response {\n        final code: Int;\n        final body: String;\n    }\n\n    pub extern async fn fetch(url: String) : Response {}\n\n    async fn handle_request(url: String) : Void {\n        let resp = try await fetch(url);\n        \n        match resp {\n            Response { code: 200, body: b } => {\n                print(\"Success: \" + b);\n            }\n            Response { code: n, body: _ } if n >= 500 => {\n                print(\"Server Error\");\n            }\n            _ => print(\"Unknown error\");\n        }\n    }\n\n    fn main() {\n        ignore await handle_request(\"https://api.example.com\");\n    }\n}",
