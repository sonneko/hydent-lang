      "kind": "RawDeclaration",
      "value": {
        "type": "RawDeclaration",
        "category": "Function",
        "source": "fn process_data(input: Vec<Int>) : Vec<Int> {\n    let result = pipe input {\n        |> list => list.filter((x) -> x > 0)\n        |> filtered => filtered.map((x) -> x * 2)\n    };\n\n    let mut final_list = Vec::new();\n    for x in result {\n        |> val if val % 4 == 0 => final_list.push(val);\n        |> _ => continue;\n    }\n\n    return final_list;\n}",
