        "type": "RawDeclaration",
        "category": "Class",
        "source": "class Stack<T> {\n    mut data: Vec<T>;\n    \n    pub fn new() : Stack<T> {\n        return Stack { data: Vec::new() };\n    }\n\n    pub fn push(mut this, item: T) : Void {\n        this.data.push(item);\n    }\n\n    pub fn pop(mut this) : T panics {\n        if let Some(val) = this.data.pop() {\n            return val;\n        } else {\n            return panic(\"Stack empty\");\n        }\n    }\n\n    pub fn is_empty(this) : Bool {\n        return this.data.len() == 0;\n    }\n}",
