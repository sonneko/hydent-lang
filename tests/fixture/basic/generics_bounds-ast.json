      "value": {
        "type": "RawDeclaration",
        "category": "Function",
        "source": "fn display_result<T : Printable, E : Printable>(res: Result<T, E>) : Void {\n    match res {\n        Result::Ok(val) => {\n            print(\"Value: \" + val.to_string());\n        }\n        Result::Err(err) => {\n            print(\"Error: \" + err.to_string());\n        }\n    }\n}",
