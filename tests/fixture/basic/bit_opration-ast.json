        "source": "fn main() {\n    let mut my_perms: Flags = READ | WRITE;\n    \n    if check_permission(my_perms, READ) {\n        print(\"Can read\");\n    }\n\n    my_perms = my_perms ^ WRITE; // Toggle write\n    \n    let combined = (READ | WRITE) & ~READ;\n    print(combined as Int);\n}",
