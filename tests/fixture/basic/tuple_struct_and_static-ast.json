    {
      "kind": "RawDeclaration",
      "value": {
        "type": "RawDeclaration",
        "category": "Module",
        "source": "module ComplexOps {\n    pub fn add(a: Complex, b: Complex) : Complex {\n        let (r1, i1) = a;\n        let (r2, i2) = b;\n        return Complex(r1 + r2, i1 + i2);\n    }\n\n    pub fn scale(c: Complex, factor: Float) : Complex {\n        let Complex(r, i) = c;\n        return Complex(r * factor, i * factor);\n    }\n\n    static ZERO = Complex(0.0, 0.0);\n    static ONE = Complex(1.0, 0.0);\n}",
