        "source": "fn main() {\n    let multiplier = 3;\n    let result = apply_twice(10, (mut x: Int) -> {\n        let factor = 2;\n        return x * factor + multiplier;\n    });\n\n    let simple = apply_twice(5, (n) -> n + 1);\n    \n    print(result);\n}",
