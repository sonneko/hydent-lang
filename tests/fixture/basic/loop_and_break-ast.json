      "value": {
        "type": "RawDeclaration",
        "category": "Function",
        "source": "fn find_in_matrix(matrix: Vec<Vec<Int>>, target: Int) : Bool {\n    let found = loop \"search\" {\n        for row in matrix {\n            for val in row {\n                if val == target {\n                    break \"search\" true;\n                }\n            }\n        }\n        break false;\n    };\n    return found;\n}",
