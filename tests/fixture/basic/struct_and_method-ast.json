        "source": "module Vec2 {\n    pub fn length(v: Vec2) : Float {\n        return (v.x ** 2.0 + v.y ** 2.0) ** 0.5;\n    }\n\n    pub fn dot(a: Vec2, b: Vec2) : Float {\n        return a.x * b.x + a.y * b.y;\n    }\n}",
