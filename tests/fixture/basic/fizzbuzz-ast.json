        "source": "fn fizz_buzz(n: Int) {\n    match (n % 3, n % 5) {\n        (0, 0) => println(\"fizzbuzz\"),\n        (0, _) => println(\"fizz\"),\n        (_, 0) => println(\"buzz\"),\n        (_, _) => println(n),\n    }\n}",
