      "value": {
        "type": "RawDeclaration",
        "category": "Module",
        "source": "module Geometry {\n    pub protocol Shape {\n        fn area(this) : Float;\n    }\n\n    pub struct Rect {\n        final width: Float;\n        final height: Float;\n    }\n\n    pub struct Circle(final Float);\n\n    fn calculate_area<T : Shape>(item: T) : Float {\n        return item.area();\n    }\n\n    static PI = 3.141592;\n\n    fn main() {\n        let r = Rect { width: 10.0, height: 5.0 };\n        let c = Circle(2.5);\n\n        ignore pipe r.area() {\n            |> a if a > 10.0 => print(\"Large\");\n            |> _ => print(\"Small\");\n        }\n\n        let total: Float = r.area() + c.area();\n    }\n}",
