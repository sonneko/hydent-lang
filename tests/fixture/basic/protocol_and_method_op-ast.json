      "kind": "RawDeclaration",
      "value": {
        "type": "RawDeclaration",
        "category": "Class",
        "source": "class Dispatcher {\n    mut listeners: Vec<Listener>;\n\n    pub fn add(mut this, l: Listener) : Void {\n        this.listeners.push(l);\n    }\n\n    pub fn notify(this, message: String) : Void {\n        for l in this.listeners {\n            l.on_event(message);\n        }\n    }\n}",
